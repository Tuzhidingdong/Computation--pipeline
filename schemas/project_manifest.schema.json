{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Tuzhidingdong/Computation--pipeline/schemas/project_manifest.schema.json",
  "title": "Coordination DFT Project Manifest",
  "type": "object",
  "required": [
    "schema_version",
    "project",
    "systems",
    "models",
    "method",
    "tasks",
    "claims",
    "evidence",
    "diagnostics",
    "compilation_status",
    "source_document",
    "field_provenance",
    "profile_overlay",
    "profile_field_provenance",
    "profile_reconciliation",
    "unresolved_structured_fields"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "project": {
      "type": "object",
      "required": [
        "project_id",
        "source_format"
      ],
      "properties": {
        "project_id": {
          "type": "string",
          "minLength": 1
        },
        "plan_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_format": {
          "const": "docx"
        }
      },
      "additionalProperties": true
    },
    "systems": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "models": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "method": {
      "type": "object"
    },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "task_count_claims": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "input_outputs": {
      "type": "object"
    },
    "resources": {
      "type": "object"
    },
    "scientific_constraints": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "unresolved_definitions": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "evidence_id",
          "source",
          "block_kind",
          "text"
        ],
        "properties": {
          "evidence_id": {
            "type": "string"
          },
          "source": {
            "type": "object"
          },
          "block_kind": {
            "enum": [
              "paragraph",
              "table_cell"
            ]
          },
          "text": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "compilation_status": {
      "enum": [
        "BLOCKED",
        "NEEDS_REVIEW",
        "READY_FOR_APPROVAL"
      ]
    },
    "source_document": {
      "type": "object",
      "required": [
        "file_name",
        "size_bytes",
        "sha256",
        "parser"
      ],
      "properties": {
        "file_name": {
          "type": "string",
          "minLength": 1
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "parser": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": true
    },
    "field_provenance": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "status",
          "source_kind",
          "evidence_ids"
        ],
        "properties": {
          "status": {
            "enum": [
              "docx_evidence",
              "profile",
              "unresolved",
              "absent"
            ]
          },
          "source_kind": {
            "enum": [
              "docx_evidence",
              "profile",
              "unresolved",
              "absent"
            ]
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "raw_values": {
            "type": "array"
          },
          "source_path": {
            "type": "string"
          },
          "profile_field": {
            "type": "string"
          },
          "reconciliation_status": {
            "enum": [
              "consistent",
              "conflict",
              "needs_review",
              "profile_only",
              "not_compared"
            ]
          }
        },
        "additionalProperties": true
      }
    },
    "profile_overlay": {
      "type": "object",
      "required": [
        "source_kind",
        "profile_source",
        "profile_version",
        "values"
      ],
      "properties": {
        "source_kind": {
          "const": "profile"
        },
        "profile_source": {
          "type": "string"
        },
        "profile_version": {
          "type": "string"
        },
        "values": {
          "type": "object"
        }
      },
      "additionalProperties": true
    },
    "profile_field_provenance": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "status",
          "source_kind",
          "evidence_ids"
        ],
        "properties": {
          "status": {
            "enum": [
              "docx_evidence",
              "profile",
              "unresolved",
              "absent"
            ]
          },
          "source_kind": {
            "enum": [
              "docx_evidence",
              "profile",
              "unresolved",
              "absent"
            ]
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "raw_values": {
            "type": "array"
          },
          "source_path": {
            "type": "string"
          },
          "profile_field": {
            "type": "string"
          },
          "reconciliation_status": {
            "enum": [
              "consistent",
              "conflict",
              "needs_review",
              "profile_only",
              "not_compared"
            ]
          }
        },
        "additionalProperties": true
      }
    },
    "profile_reconciliation": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "field",
          "profile_value",
          "profile_source",
          "docx_status",
          "docx_evidence_ids",
          "status"
        ],
        "properties": {
          "field": {
            "type": "string"
          },
          "profile_source": {
            "type": "string"
          },
          "docx_status": {
            "enum": [
              "docx_evidence",
              "unresolved",
              "absent"
            ]
          },
          "docx_evidence_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "status": {
            "enum": [
              "consistent",
              "conflict",
              "needs_review",
              "profile_only",
              "not_compared"
            ]
          }
        },
        "additionalProperties": true
      }
    },
    "unresolved_structured_fields": {
      "type": "array",
      "items": {
        "type": "object"
      }
    }
  },
  "additionalProperties": true
}
